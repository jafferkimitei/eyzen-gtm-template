___TESTS___

scenarios:
- name: Sets the Site ID and loads Eyzen
  code: |-
    const mockData = { siteId: 'eyzs_test', position: 'left' };

    mock('injectScript', function (url, onSuccess) {
      assertThat(url).isEqualTo('https://eyzen.eycube.com/embed/v1/eyzen.js');
      onSuccess();
    });

    runCode(mockData);

    assertThat(require('copyFromWindow')('EyzenConfig')).isEqualTo({ site: 'eyzs_test', position: 'left' });
    assertApi('gtmOnSuccess').wasCalled();
setup: ''


