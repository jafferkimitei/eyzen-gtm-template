___SANDBOXED_JS_FOR_WEB_TEMPLATE___

// Eyzen reads its Site ID from window.EyzenConfig, because a template can't
// set attributes on the script it loads.
const injectScript = require('injectScript');
const setInWindow = require('setInWindow');
const logToConsole = require('logToConsole');

const config = { site: data.siteId };

if (data.position === 'left' || data.position === 'right') {
  config.position = data.position;
}

setInWindow('EyzenConfig', config, true);

injectScript(
  'https://eyzen.eycube.com/embed/v1/eyzen.js',
  data.gtmOnSuccess,
  function () {
    logToConsole('Eyzen Chat: the Eyzen script could not be loaded.');
    data.gtmOnFailure();
  },
  'eyzen-chat'
);


